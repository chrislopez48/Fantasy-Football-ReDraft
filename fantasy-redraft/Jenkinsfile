
pipeline {
    agent {
        label 'fantasy-builder'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                dir('fantasy-redraft')
                {
                    sh 'python3 --version'
                    sh 'ls -la'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('fantasy-redraft') {
                    sh '''
                python3 -m venv .venv
                .venv/bin/python -m pip install -r requirements.txt
            '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('fantasy-redraft') {
                    sh '.venv/bin/python -m compileall -q backend ingestion transformations pipeline'
                    sh '.venv/bin/python -m pytest tests/ -v'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('fantasy-redraft') {
                    sh 'docker build -t fantasy-redraft:latest .'
                }
            }
        }

        stage('Verify AWS Authentication') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'fantasy-redraft-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh 'aws sts get-caller-identity'
                }
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                withCredentials([
            usernamePassword(
                credentialsId: 'fantasy-redraft-aws',
                usernameVariable: 'AWS_ACCESS_KEY_ID',
                passwordVariable: 'AWS_SECRET_ACCESS_KEY'
            )
        ]) {
                    sh '''
                set +x
                set -eu

                AWS_REGION=us-east-1
                ECR_REGISTRY=131715058630.dkr.ecr.us-east-1.amazonaws.com
                ECR_REPO=$ECR_REGISTRY/fantasy-redraft

                aws ecr get-login-password --region "$AWS_REGION" |
                    docker login --username AWS --password-stdin "$ECR_REGISTRY"

                docker tag fantasy-redraft:latest "$ECR_REPO:latest"

                docker push "$ECR_REPO:latest"
            '''
        }
            }
        }
        stage('Run ECS Fargate Task') {
            steps{
                withCredentials([
                    usernamePassword(
                        credentialsId: 'fantasy-redraft-aws',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        aws ecs run-task \
                            --cluster fantasy-redraft-cluster \
                            --task-definition fantasy-redraft-task \
                            --launch-type FARGATE \
                            --count 1 \
                            --network-configuration 'awsvpcConfiguration={subnets=[subnet-0a41948b12a1eaa2b,subnet-066c9523f8db8533c,subnet-0e16ddde61ea57005,subnet-0485e78ced06f50c7,subnet-0c70a7651bd7dda13,subnet-035ae8cb7db56eb4e],securityGroups=[sg-0de653944950eeae9],assignPublicIp=ENABLED}' \
                            --region us-east-1 \
                            --no-cli-pager
                    '''
                }
            }
        }
    }
}
