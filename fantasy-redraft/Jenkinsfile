
pipeline {
    agent any
                                            
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                dir('fantasy-redraft')
                {
                    sh 'python3 --version'
                    sh 'ls -la'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('fantasy-redraft'){
                    sh 'python3 -m compileall -q backend ingestion transformations pipeline'
                }
            }
        }
    }
}
